type Query {
  # Categories
  getAllCategories: CategoryListResponse
  getCategoryById(id: ID!): CategoryResponse
  getCategoryBySlug(slug: String!): CategoryResponse
  getCategoryByName(name: String!): CategoryResponse

  # Products
  getAllProducts: ProductListResponse
  getProductById(id: ID!): ProductResponse
  getProductsByCategory(categoryId: ID!): ProductListResponse

  # Product Images
  getImagesByProductId(productId: ID!): ProductImageListResponse

  # Product Schedules
  getSchedulesByProductId(productId: ID!): ProductScheduleListResponse
}

type Mutation {
  # Categories
  createCategory(input: CategoryInput!): CategoryResponse
  updateCategory(id: ID!, input: CategoryInput!): CategoryResponse
  deleteCategory(id: ID!): BooleanResponse

  # Products
  createProduct(input: ProductInput!): ProductResponse
  updateProduct(id: ID!, input: ProductInput!): ProductResponse
  deleteProduct(id: ID!): BooleanResponse

  # Product Images
  addImageToProduct(input: ProductImageInput!): ProductImageResponse
  deleteProductImage(id: ID!): BooleanResponse
  setPrimaryImage(id: ID!): ProductImageResponse

  # Product Schedules
  addScheduleToProduct(input: ProductScheduleInput!): ProductScheduleResponse
  updateProductSchedule(id: ID!, input: ProductScheduleInput!): ProductScheduleResponse
  deleteProductSchedule(id: ID!): BooleanResponse
}

type Category {
  id: ID
  name: String
  slug: String
  isDeleted: Boolean
  products: [Product]
}

type Product {
  id: ID
  title: String
  description: String
  price: Float
  thumbnail: String
  duration: String
  startLocation: String
  createdAt: String
  updatedAt: String
  isDeleted: Boolean
  category: Category
  schedules: [ProductSchedule]
  images: [ProductImage]
}

type ProductSchedule {
  id: ID
  dayNumber: Int
  title: String
  content: String
  createdAt: String
  updatedAt: String
}

type ProductImage {
  id: ID
  imageUrl: String
  isPrimary: Boolean
  createdAt: String
  updatedAt: String
}

input CategoryInput {
  name: String!
  slug: String!
}

input ProductInput {
  categoryId: ID!
  title: String!
  description: String
  price: Float!
  thumbnail: String
  duration: String
  startLocation: String
}

input ProductImageInput {
  productId: ID!
  imageUrl: String!
  isPrimary: Boolean
}

input ProductScheduleInput {
  productId: ID!
  dayNumber: Int!
  title: String!
  content: String
}

type CategoryResponse {
  code: String
  message: String
  data: Category
}

type CategoryListResponse {
  code: String
  message: String
  data: [Category]
}

type BooleanResponse {
  code: String
  message: String
  data: Boolean
}

type ProductResponse {
  code: String
  message: String
  data: Product
}

type ProductListResponse {
  code: String
  message: String
  data: [Product]
}

type ProductImageResponse {
  code: String
  message: String
  data: ProductImage
}

type ProductImageListResponse {
  code: String
  message: String
  data: [ProductImage]
}

type ProductScheduleResponse {
  code: String
  message: String
  data: ProductSchedule
}

type ProductScheduleListResponse {
  code: String
  message: String
  data: [ProductSchedule]
}
