type Query {
  # Categories
  getAllCategories: CategoryListResponse
  getCategoryById(id: ID!): CategoryResponse
  getCategoryBySlug(slug: String!): CategoryResponse
  getCategoryByName(name: String!): CategoryResponse

  # Tours
  getAllTours: TourListResponse
  getTourById(id: ID!): TourResponse
  getToursByCategory(categoryId: ID!): TourListResponse
}

type Mutation {
  # Categories
  createCategory(input: CategoryInput!): CategoryResponse
  updateCategory(id: ID!, input: CategoryInput!): CategoryResponse
  deleteCategory(id: ID!): BooleanResponse

  # Tours
  createTour(input: TourInput!): TourResponse
  updateTour(id: ID!, input: TourInput!): TourResponse
  deleteTour(id: ID!): BooleanResponse
}

type Category {
  id: ID
  name: String
  slug: String
  isDeleted: Boolean
  tours: [Tour]
}

type Tour {
  id: ID
  title: String
  description: String
  price: Float
  thumbnail: String
  duration: String
  startLocation: String
  createdAt: String
  updatedAt: String
  isDeleted: Boolean
  category: Category
  schedules: [TourSchedule]
  images: [TourImage]
}

type TourSchedule {
  id: ID
  dayNumber: Int
  title: String
  content: String
  createdAt: String
  updatedAt: String
}

type TourImage {
  id: ID
  imageUrl: String
  isPrimary: Boolean
  createdAt: String
  updatedAt: String
}

input CategoryInput {
  name: String!
  slug: String!
}

input TourInput {
  categoryId: ID!
  title: String!
  description: String
  price: Float!
  thumbnail: String
  duration: String
  startLocation: String
}

type CategoryResponse {
  code: String
  message: String
  data: Category
}

type CategoryListResponse {
  code: String
  message: String
  data: [Category]
}

type BooleanResponse {
  code: String
  message: String
  data: Boolean
}

type TourResponse {
  code: String
  message: String
  data: Tour
}

type TourListResponse {
  code: String
  message: String
  data: [Tour]
}
